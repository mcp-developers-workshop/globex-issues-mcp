# Copy this file to .env and fill in a real GitLab project access token.
# .env is git-ignored. Never commit a token.
#
# Only run time values belong here. Anything Quarkus fixes at build time - the MCP
# transport, for instance - lives in src/main/resources/application.properties instead.

# GitLab project access token with the 'api' scope on globex/globex-issues.
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx

# Optional: point the server at a different GitLab.
# QUARKUS_REST_CLIENT_GITLAB_API_URL=https://gitlab-gitlab.apps.itz-2p9ej5.hub04-lb.techzone.ibm.com

# Optional: point the server at a different project.
# GITLAB_PROJECT_ID=5
